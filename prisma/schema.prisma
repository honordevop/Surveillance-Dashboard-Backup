generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

model IncidentReport {
    id           String             @id @default(uuid())
    date         DateTime           @db.Date
    location     String
    incidentType String
    details      String
    createdAt    DateTime           @default(now())
    updatedAt    DateTime           @updatedAt
    embedding    IncidentEmbedding?

    @@unique([date, location, incidentType], name: "incident_unique")
}

model IncidentEmbedding {
    incidentReportId String                @id
    embedding        Unsupported("vector")
    incident         IncidentReport        @relation(fields: [incidentReportId], references: [id], onDelete: Cascade)
}

model Year {
    id     Int     @id @default(autoincrement())
    year   Int     @unique
    months Month[]
}

model Month {
    id              Int              @id @default(autoincrement())
    month           Int
    yearId          Int
    burntAssets     BurntAsset[]
    illegalSites    IllegalSite[]
    year            Year             @relation(fields: [yearId], references: [id], onDelete: Cascade)
    monthlyIncident MonthlyIncident?
    operationImages OperationImage[]
    leakageSites    LeakageSite[]

    @@unique([yearId, month])
}

model MonthlyIncident {
    id                 Int   @id @default(autoincrement())
    monthId            Int   @unique
    illegalConnections Int   @default(0)
    illegalRefineries  Int   @default(0)
    oilLeaks           Int   @default(0)
    gasLeaks           Int   @default(0)
    arrestsMade        Int   @default(0)
    aversions          Int   @default(0)
    litersAGO          Float @default(0)
    litersPMS          Float @default(0)
    litersCrude        Float @default(0)
    month              Month @relation(fields: [monthId], references: [id], onDelete: Cascade)
}

model IllegalSite {
    id       Int          @id @default(autoincrement())
    monthId  Int
    category SiteCategory
    location String
    lat      Float
    lng      Float
    month    Month        @relation(fields: [monthId], references: [id], onDelete: Cascade)
}

model BurntAsset {
    id      Int     @id @default(autoincrement())
    monthId Int
    name    String
    notes   String?
    month   Month   @relation(fields: [monthId], references: [id], onDelete: Cascade)
}

model LeakageSite {
    id       Int    @id @default(autoincrement())
    monthId  Int
    category String
    location String
    lat      Float
    lng      Float
    month    Month  @relation(fields: [monthId], references: [id], onDelete: Cascade)

    @@map("leakage_sites")
}

model OperationImage {
    id        Int      @id @default(autoincrement())
    monthId   Int
    path      String
    publicUrl String
    caption   String?
    createdAt DateTime @default(now())
    month     Month    @relation(fields: [monthId], references: [id], onDelete: Cascade)
}

model User {
    id        Int      @id @default(autoincrement())
    name      String?
    email     String   @unique
    password  String
    corridor  String?
    role      String   @default("admin") // e.g. "admin", "superadmin", ...
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

enum SiteCategory {
    ILLEGAL_CONNECTION
    ILLEGAL_REFINERY
    OTHER
}
