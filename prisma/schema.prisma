// prisma/schema.prisma
generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL") // pooled (pgBouncer) for app runtime
    directUrl = env("DIRECT_URL") // direct for migrations
}

model IncidentReport {
    id           String   @id @default(uuid())
    date         DateTime @db.Date
    location     String
    incidentType String
    details      String
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    embedding IncidentEmbedding?

    @@unique([date, location, incidentType], name: "incident_unique")
}

model IncidentEmbedding {
    incidentReportId String                      @id
    incident         IncidentReport              @relation(fields: [incidentReportId], references: [id], onDelete: Cascade)
    embedding        Unsupported("vector(1536)")
}

